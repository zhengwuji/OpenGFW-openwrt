#!/bin/sh
# OpenGFW 自定义域名与 IP 拦截管理助手
# 管理 /etc/opengfw/custom_rules.json 并自动同步编译至 /etc/opengfw/rules.yaml

CONF_DIR="/etc/opengfw"
CUSTOM_JSON="${CONF_DIR}/custom_rules.json"
RULES_FILE="${CONF_DIR}/rules.yaml"

mkdir -p "$CONF_DIR"

if [ ! -f "$CUSTOM_JSON" ]; then
    echo "[]" > "$CUSTOM_JSON"
fi

get_json() {
    if [ -f "$CUSTOM_JSON" ]; then
        cat "$CUSTOM_JSON"
    else
        echo "[]"
    fi
}

apply_rules() {
    if [ ! -f "$RULES_FILE" ]; then
        touch "$RULES_FILE"
    fi

    # 生成自定义规则 YAML 片段
    local tmp_yaml="/tmp/opengfw_custom_block.yaml"
    cat <<'EOF' > "$tmp_yaml"
# --- BEGIN_CUSTOM_RULES ---
# 自定义域名与 IP 拦截清单 (由【自定义拦截】控制台自动生成，支持热重载)
EOF

    # 使用 awk / python / sed 解析 JSON 并生成 YAML 规则
    python3 -c "
import json, re, sys

try:
    with open('${CUSTOM_JSON}', 'r', encoding='utf-8') as f:
        rules = json.load(f)
except Exception as e:
    rules = []

for r in rules:
    if not r.get('enabled', True):
        continue
    rtype = r.get('type', 'domain').lower()
    val = r.get('value', '').strip()
    if not val:
        continue
    action = r.get('action', 'block').lower()
    if action not in ['allow', 'block', 'drop']:
        action = 'block'
    direction = r.get('direction', 'both').lower()
    comment = r.get('comment', '').replace('\"', '')

    safe_name = re.sub(r'[^a-zA-Z0-9_-]', '_', val)[:30]
    rule_name = f'自定义{action}-{safe_name}'
    if comment:
        rule_name += f' ({comment})'

    if rtype == 'domain':
        val_clean = val.lower().lstrip('.')
        # 匹配根域名及其所有子域名，覆盖 TLS SNI, HTTP Host, DNS 查询及 QUIC
        expr = f'(tls != nil && (tls.sni == \"{val_clean}\" || tls.sni endsWith \".{val_clean}\")) || (http != nil && (http.host == \"{val_clean}\" || http.host endsWith \".{val_clean}\")) || (dns != nil && (dns.name == \"{val_clean}\" || dns.name endsWith \".{val_clean}\")) || (quic != nil && (quic.sni == \"{val_clean}\" || quic.sni endsWith \".{val_clean}\"))'
    else:
        # IP / CIDR 处理
        cidr_val = val
        if '/' not in cidr_val:
            if ':' in cidr_val:
                cidr_val += '/128'
            else:
                cidr_val += '/32'
        
        if direction == 'inbound':
            expr = f'cidr(ip.src, \"{cidr_val}\")'
        elif direction == 'outbound':
            expr = f'cidr(ip.dst, \"{cidr_val}\")'
        else: # both
            expr = f'cidr(ip.dst, \"{cidr_val}\") || cidr(ip.src, \"{cidr_val}\")'

    print(f'- name: \"{rule_name}\"')
    print(f'  action: {action}')
    print(f'  log: true')
    print(f'  expr: {expr}')
    print('')
" >> "$tmp_yaml" 2>/dev/null

    echo "# --- END_CUSTOM_RULES ---" >> "$tmp_yaml"

    # 将生成的片段原子合并入 rules.yaml
    python3 -c "
with open('${tmp_yaml}', 'r', encoding='utf-8') as f:
    new_block = f.read()

rules_file = '${RULES_FILE}'
try:
    with open(rules_file, 'r', encoding='utf-8') as f:
        content = f.read()
except:
    content = ''

if '# --- BEGIN_CUSTOM_RULES ---' in content and '# --- END_CUSTOM_RULES ---' in content:
    # 替换已有区块
    pattern_start = '# --- BEGIN_CUSTOM_RULES ---'
    pattern_end = '# --- END_CUSTOM_RULES ---'
    p1 = content.find(pattern_start)
    p2 = content.find(pattern_end) + len(pattern_end)
    new_content = content[:p1] + new_block + content[p2:]
else:
    # 插入到最顶层（或者用户白名单下方）
    if '# 0. 用户自定义白名单' in content:
        idx = content.find('# 0. 用户自定义白名单')
        new_content = content[:idx] + new_block + '\n\n' + content[idx:]
    else:
        new_content = new_block + '\n\n' + content

with open(rules_file, 'w', encoding='utf-8') as f:
    f.write(new_content)
"
    rm -f "$tmp_yaml"

    # 执行平滑热重载 (无需重启守护进程)
    local pid=$(pidof opengfw | awk '{print $1}')
    if [ -n "$pid" ]; then
        kill -HUP "$pid" 2>/dev/null
        logger -t opengfw "Custom rules applied & reloaded via SIGHUP (PID: $pid)"
    fi

    echo "{\"status\": \"ok\", \"message\": \"自定义规则已成功编译并热重载生效！\"}"
}

# 聚合拦截日志中「木马/全加密检测」命中的目标, 供 LuCI「一键加白」面板使用
recent_blocks() {
    python3 - <<'PY'
import json, re, ipaddress, sys
sys.path.insert(0, '/etc/opengfw')
try:
    from geoip_lookup import lookup as _geo
except Exception:
    _geo = lambda ip: ''

LOG = '/var/log/opengfw.log'
CUSTOM = '/etc/opengfw/custom_rules.json'

entries = {}
try:
    pat = re.compile(r'^(\S+).*"name": "([^"]+)", .*"dst": "([^"]+)"')
    with open(LOG, 'r', encoding='utf-8', errors='ignore') as f:
        for line in f:
            if '"name": "block fully-encrypted"' not in line and '"name": "block trojan"' not in line:
                continue
            m = pat.match(line)
            if not m:
                continue
            ts = m.group(1).replace('T', ' ')[:19]
            rule, dst = m.group(2), m.group(3)
            if dst.startswith('['):
                idx = dst.find(']')
                ip = dst[1:idx]
                port = dst[idx + 2:].lstrip(':')
            else:
                parts = dst.rsplit(':', 1)
                ip, port = parts[0], (parts[1] if len(parts) == 2 else '')
            try:
                ipo = ipaddress.ip_address(ip)
                if ipo.is_private or ipo.is_loopback or ipo.is_multicast or ipo.is_reserved or ipo.is_unspecified:
                    continue
            except ValueError:
                continue
            e = entries.setdefault(ip, {'ip': ip, 'ports': set(), 'rules': set(), 'count': 0, 'last': ''})
            if port.isdigit():
                e['ports'].add(port)
            e['rules'].add(rule)
            e['count'] += 1
            if ts > e['last']:
                e['last'] = ts
except FileNotFoundError:
    pass

allow_nets = []
try:
    with open(CUSTOM, 'r', encoding='utf-8') as f:
        for r in json.load(f):
            if r.get('action') == 'allow' and r.get('type') == 'ip':
                try:
                    allow_nets.append(ipaddress.ip_network(str(r.get('value', '')).strip(), strict=False))
                except ValueError:
                    pass
except Exception:
    pass

items = []
for e in entries.values():
    e['allowed'] = any(ipaddress.ip_address(e['ip']) in n for n in allow_nets)
    e['ports'] = sorted(e['ports'])[:6]
    e['rules'] = sorted(e['rules'])
    e['country'] = _geo(e['ip'])
    items.append(e)

items.sort(key=lambda x: (x['allowed'], -x['count'], x['ip']))
print(json.dumps({'status': 'ok', 'items': items[:100]}, ensure_ascii=False))
PY
}

# 命令行快捷加白: allow <IP或CIDR> [备注]
allow_ip() {
    local ip="$1"
    [ -z "$ip" ] && { echo '{"status":"error","message":"用法: allow <IP或CIDR> [备注]"}'; return 1; }
    case "$ip" in
        *[!0-9a-fA-F.:/]*)
            echo '{"status":"error","message":"IP 格式无效"}'
            return 1
            ;;
    esac
    local comment
    comment=$(printf '%s' "$2" | tr -d "'\"")
    python3 -c "
import json, time
ip = '${ip}'.strip()
comment = '''${comment}'''.strip() or '手动加白'
try:
    with open('${CUSTOM_JSON}', 'r', encoding='utf-8') as f:
        rules = json.load(f)
except Exception:
    rules = []
for r in rules:
    if r.get('type') == 'ip' and r.get('action') == 'allow' and str(r.get('value', '')).split('/')[0] == ip.split('/')[0]:
        print(json.dumps({'status': 'ok', 'message': '已存在于白名单, 无需重复添加', 'ip': ip}, ensure_ascii=False))
        raise SystemExit(0)
rules.insert(0, {'id': 'w_%d' % (time.time() * 1000), 'type': 'ip', 'value': ip, 'action': 'allow',
                 'direction': 'both', 'comment': comment, 'enabled': True,
                 'time': time.strftime('%Y-%m-%d %H:%M:%S')})
with open('${CUSTOM_JSON}', 'w', encoding='utf-8') as f:
    json.dump(rules, f, ensure_ascii=False, indent=2)
"
    apply_rules
}

case "$1" in
    get)
        get_json
        ;;
    apply)
        apply_rules
        ;;
    recent-blocks)
        recent_blocks
        ;;
    apply)
        apply_rules
        ;;
    set)
        # 从标准输入或 $2 写入并应用
        if [ -n "$2" ]; then
            echo "$2" > "$CUSTOM_JSON"
        else
            cat > "$CUSTOM_JSON"
        fi
        apply_rules
        ;;
    clear)
        echo "[]" > "$CUSTOM_JSON"
        apply_rules
        ;;
    allow)
        allow_ip "$2" "$3"
        ;;
    geoip-lookup)
        python3 /etc/opengfw/geoip_lookup.py "$2" 2>/dev/null || echo '{}'
        ;;
    *)
        echo "Usage: $0 {get|apply|set|clear|recent-blocks|allow <IP> [备注]|geoip-lookup <JSON数组>}"
        exit 1
        ;;
esac
