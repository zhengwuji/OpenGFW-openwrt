#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/opengfw
CONF_DIR=/etc/opengfw
LOG_FILE=/var/log/opengfw.log

generate_config() {
	local mode workers queue_size rcv_buf snd_buf rst
	local tcp_pages tcp_conn udp_streams geoip geosite
	local is_local="false"

	config_load opengfw
	config_get mode global mode "forward"
	config_get workers global workers "2"
	config_get queue_size global queue_size "2048"
	config_get rcv_buf global rcv_buf "8388608"
	config_get snd_buf global snd_buf "8388608"
	config_get rst global rst "0"
	config_get tcp_pages global tcp_max_pages_total "4096"
	config_get tcp_conn global tcp_max_pages_per_conn "64"
	config_get udp_streams global udp_max_streams "4096"
	config_get geoip global geoip_path "/etc/opengfw/geoip.dat"
	config_get geosite global geosite_path "/etc/opengfw/geosite.dat"

	[ "$mode" = "local" ] && is_local="true"

	mkdir -p "$CONF_DIR"

	cat > "$CONF_DIR/config.yaml" <<EOF
io:
  queueSize: ${queue_size:-2048}
  rcvBuf: ${rcv_buf:-8388608}
  sndBuf: ${snd_buf:-8388608}
  local: ${is_local}
  rst: $([ "$rst" = "1" ] && echo "true" || echo "false")

workers:
  count: ${workers:-2}
  queueSize: 16
  tcpMaxBufferedPagesTotal: ${tcp_pages:-4096}
  tcpMaxBufferedPagesPerConn: ${tcp_conn:-64}
  udpMaxStreams: ${udp_streams:-4096}

ruleset:
  geoip: ${geoip}
  geosite: ${geosite}
EOF
}

start_service() {
	local enabled log_level log_format rules_path

	config_load opengfw
	config_get enabled global enabled "0"
	[ "$enabled" -eq 1 ] || return 0

	config_get log_level global log_level "info"
	config_get log_format global log_format "console"
	config_get rules_path global rules_path "$CONF_DIR/rules.yaml"

	if [ ! -f "$PROG" ]; then
		logger -t opengfw "Error: binary $PROG not found"
		return 1
	fi

	# Load required kernel module if not already loaded
	if ! lsmod | grep -q nfnetlink_queue; then
		modprobe nfnetlink_queue 2>/dev/null
	fi

	# Kernel netlink buffer and backlog optimization
	sysctl -w net.core.rmem_max=8388608 >/dev/null 2>&1
	sysctl -w net.core.wmem_max=8388608 >/dev/null 2>&1
	sysctl -w net.core.netdev_max_backlog=4096 >/dev/null 2>&1

	mkdir -p "$CONF_DIR"
	if [ ! -f "$rules_path" ]; then
		if [ -f "$CONF_DIR/rules.yaml.example" ]; then
			cp "$CONF_DIR/rules.yaml.example" "$rules_path"
		fi
	fi

	generate_config

	ulimit -n 65535
	touch "$LOG_FILE"

	procd_open_instance "opengfw"
	procd_set_param command /bin/sh -c "exec $PROG -c $CONF_DIR/config.yaml -l $log_level -f $log_format $rules_path >> $LOG_FILE 2>&1"
	procd_set_param respawn 3600 5 0
	procd_set_param file "$rules_path" "/etc/config/opengfw"
	procd_set_param user root
	procd_close_instance

	logger -t opengfw "OpenGFW service started successfully in $log_level level"
}

stop_service() {
	# Clean up nft table defensively to avoid lingering queue rules
	nft delete table inet opengfw 2>/dev/null || true
	logger -t opengfw "OpenGFW service stopped and nft table cleared"
}

reload_service() {
	local pid
	pid=$(pidof opengfw)
	if [ -n "$pid" ]; then
		kill -HUP "$pid" 2>/dev/null
		logger -t opengfw "OpenGFW rules reloaded via SIGHUP (PID: $pid)"
	else
		restart
	fi
}

service_triggers() {
	procd_add_reload_trigger "opengfw"
}
