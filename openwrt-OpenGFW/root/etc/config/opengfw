config opengfw 'global'
	option enabled '1'
	option mode 'forward'
	option workers '2'
	option queue_size '2048'
	option rcv_buf '8388608'
	option snd_buf '8388608'
	option log_level 'info'
	option log_format 'console'
	option rst '1'
	option tcp_max_pages_total '4096'
	option tcp_max_pages_per_conn '64'
	option udp_max_streams '4096'
	# TCP 流空闲回收(秒):超过该时长没有任何流量的 TCP 连接会被引擎释放,
	# 防止连接池无限增长吃光内存。0 = 默认 600;负数 = 关闭回收(不推荐)。
	option tcp_stream_timeout '600'
	option geoip_path '/etc/opengfw/geoip.dat'
	option geosite_path '/etc/opengfw/geosite.dat'
	option rules_path '/etc/opengfw/rules.yaml'
	option config_path '/etc/opengfw/config.yaml'

config opengfw 'geoip'
	option enabled '0'
	option mode 'blacklist'
	option direction 'src'
	option countries ''
	option autoupdate '1'
	option freq 'weekly'
