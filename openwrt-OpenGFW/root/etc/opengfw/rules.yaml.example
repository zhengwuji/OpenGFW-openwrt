# --- BEGIN_DEVICE_BYPASS ---
# --- END_DEVICE_BYPASS ---

# ==============================================================================
# OpenGFW 流量过滤与深度包检测 (DPI) 规则集（GUI 可视化管理版）
# 规则说明：规则按自上而下匹配，一旦命中带 action 的规则即终止判定
# ==============================================================================

# --- BEGIN_CUSTOM_RULES ---
# 自定义域名与 IP 拦截清单 (由【自定义拦截】控制台自动生成，支持热重载)
# --- END_CUSTOM_RULES ---

# ------------------------------------------------------------------------------
# 0. 用户自定义白名单（最高优先级，直接内核直通，杜绝误杀）
# ------------------------------------------------------------------------------
- name: allow whitelist tls
  action: allow
  expr: tls != nil && tls.sni != nil && geosite(tls.sni, "whitelist")

- name: allow whitelist http
  action: allow
  expr: http != nil && http.host != nil && geosite(http.host, "whitelist")

- name: allow whitelist quic
  action: allow
  expr: quic != nil && quic.sni != nil && geosite(quic.sni, "whitelist")

- name: allow whitelist dns
  action: allow
  expr: dns != nil && dns.name != nil && geosite(dns.name, "whitelist")


# ------------------------------------------------------------------------------

# 1. 核心基础设施与管理端口放行（确保 SSH 与后台管理绝对安全）
# ------------------------------------------------------------------------------
- name: allow ssh
  action: allow
  expr: port.dst == 22 || port.src == 22

- name: allow router web management
  action: allow
  expr: (port.dst == 80 || port.dst == 443) && (cidr(ip.dst, "10.0.0.0/8") || cidr(ip.dst, "172.16.0.0/12") || cidr(ip.dst, "192.168.0.0/16"))

# ------------------------------------------------------------------------------
# 2. DNS 规避防范（阻断 DoT 与公共 DoH，迫使设备使用路由器本地安全 DNS）
# ------------------------------------------------------------------------------
# [DISABLED] - name: block dot 853
#   action: block
#   log: true
#   expr: port.dst == 853

# [DISABLED] - name: block doh providers
#   action: block
#   log: true
#   expr: tls != nil && tls.sni != nil && geosite(tls.sni, "category-doh")

# ------------------------------------------------------------------------------
# 3. 广告拦截规则组（基于 51.7万+ 条规则库底层透明过滤）
# ------------------------------------------------------------------------------
- name: block ads tls
  action: block
  log: true
  expr: tls != nil && tls.sni != nil && (geosite(tls.sni, "category-ads-all") || geosite(tls.sni, "adblockfilters"))

- name: block ads http
  action: block
  log: true
  expr: http != nil && http.host != nil && (geosite(http.host, "category-ads-all") || geosite(http.host, "adblockfilters"))

- name: block ads quic
  action: block
  log: true
  expr: quic != nil && quic.sni != nil && (geosite(quic.sni, "category-ads-all") || geosite(quic.sni, "adblockfilters"))

# 将广告域名的 DNS 应答解析修改为 0.0.0.0（温和黑洞）
# [DISABLED] - name: sinkhole ads dns
#   action: modify
#   log: true
#   expr: dns != nil && dns.qr && dns.name != nil && (geosite(dns.name, "category-ads-all") || geosite(dns.name, "adblockfilters"))
#   modifier:
#     name: dns
#     args:
#       a: "0.0.0.0"

# ------------------------------------------------------------------------------
# 5. 木马/病毒外联防线(2026-10-12 启用)
#    FET: 每个 TCP 流首包识别「全加密且非 TLS/HTTP」流量(Shadowsocks/VMess 类 C2 特征)
#    Trojan: 识别 Trojan 协议特征。若发现正常游戏/软件被误杀,注释掉这两条即可。
# ------------------------------------------------------------------------------
- name: block fully-encrypted
  action: block
  log: true
  expr: fet != nil && fet.yes

- name: block trojan
  action: block
  log: true
  expr: trojan != nil && trojan.yes

# ------------------------------------------------------------------------------
# 6. 流量审计与观察模式（在日志中打印所有内网终端访问的 TLS 域名）
# ------------------------------------------------------------------------------
- name: observe tls sni
  log: true
  expr: tls != nil && tls.sni != ""
